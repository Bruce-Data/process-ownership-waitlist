{
  "name": "process-ownership-waitlist",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "worker:dev": "wrangler dev worker/src/index.ts",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute process-ownership-waitlist --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute process-ownership-waitlist --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "astro": "5.7.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "wrangler": "^3.99.0"
  },
  "engines": {
    "node": ">=18.17.1"
  }
}
